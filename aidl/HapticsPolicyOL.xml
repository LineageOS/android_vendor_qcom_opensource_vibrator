<!--The following policies will be applicable for Openloop (OL) by default-->

<hapticsPolicyConfiguration>
    <!-- Set maxMs == UINT32_MAX to force OL -->
    <hapticsONAPI>
        <maxMs>4294967295</maxMs>
    </hapticsONAPI>
    <!-- Set effect_id == -1 to force OL -->
    <hapticsPerformAPI>
        <effect_id>-1</effect_id>
    </hapticsPerformAPI>
    <!-- Set SupportCompose == True to force OL -->
    <hapticsComposeAPI>
        <SupportCompose>True</SupportCompose>
    </hapticsComposeAPI>
    <!-- Set SupportComposePWLE == True to force OL -->
    <hapticsComposePwleAPI>
        <SupportComposePWLE>True</SupportComposePWLE>
    </hapticsComposePwleAPI>
</hapticsPolicyConfiguration>
